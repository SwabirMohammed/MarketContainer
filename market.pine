//@version=6
indicator("Sniper Edge Engine v4 [Clean Slate & Killzones]", overlay=true, max_lines_count=500, max_labels_count=500)

// 1. INPUTS & RISK
rrTarget = input.float(3.0, title="Risk-to-Reward Ratio (1:X)")
swingLen = input.int(5, title="Swing Length (For CHoCH)")
lineLen  = input.int(15, title="Projection Length (Bars)")

// Filter Inputs
useEmaFilter = input.bool(true, title="Use 200 EMA Trend Filter")
// Default is NY and London overlaps. Adjust to your broker's exchange time.
sessionZone = input.session("0800-1130,1330-1600", title="Killzones (Exchange Time)")

// 2. FILTERS (THE FIREWALL)
// Time Filter: Fills background slightly blue when active
inKillzone = not na(time(timeframe.period, sessionZone))
bgcolor(inKillzone ? color.new(color.blue, 95) : na, title="Killzone Background")

// Trend Filter: 200 EMA
ema200 = ta.ema(close, 200)
plot(useEmaFilter ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// 3. MARKET STRUCTURE (CHoCH)
sh = ta.pivothigh(high, swingLen, swingLen)
sl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
if not na(sh)
    lastSH := sh
if not na(sl)
    lastSL := sl

bullCHoCH = ta.crossover(close, lastSH)
bearCHoCH = ta.crossunder(close, lastSL)

var int bias = 0 
if bullCHoCH
    bias := 1 
if bearCHoCH
    bias := -1 

// 4. FAIR VALUE GAPS (FVG)
bullFVG = low[0] > high[2] and close[1] > high[2]
bearFVG = high[0] < low[2] and close[1] < low[2]

var float activeBullFVG = na
var float activeBearFVG = na
if bullFVG
    activeBullFVG := low[0]
if bearFVG
    activeBearFVG := high[0]

// 5. ENGULFING DISPLACEMENT
bullEngulf = close > high[1] and close > open
bearEngulf = close < low[1] and close < open

// 6. EXECUTION TRIGGERS
// Must be in Killzone + Must match EMA trend + Must have CHoCH Bias + Engulfing + FVG Tap
trendBull = not useEmaFilter or (close > ema200)
trendBear = not useEmaFilter or (close < ema200)

longTrigger  = inKillzone and trendBull and (bias == 1) and bullEngulf and (bullFVG or (low <= activeBullFVG))
shortTrigger = inKillzone and trendBear and (bias == -1) and bearEngulf and (bearFVG or (high >= activeBearFVG))

// 7. CLEAN SLATE DRAWING (Delete Old Lines automatically)
var line entryLine = na
var line slLine = na
var line tpLine = na
var label tpLabel = na
var label slLabel = na

if longTrigger
    // Erase the old geometry
    if not na(entryLine)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tpLine)
        label.delete(tpLabel)
        label.delete(slLabel)

    entryPrice = close
    slPrice = math.min(low, low[1]) 
    risk = entryPrice - slPrice
    tpPrice = entryPrice + (risk * rrTarget)

    // Draw the new geometry
    entryLine := line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.blue, width=1, style=line.style_dashed)
    slLine := line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=2, style=line.style_solid)
    tpLine := line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=2, style=line.style_solid)

    tpLabel := label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
    slLabel := label.new(bar_index + lineLen, slPrice, text="SL", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)

if shortTrigger
    // Erase the old geometry
    if not na(entryLine)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tpLine)
        label.delete(tpLabel)
        label.delete(slLabel)

    entryPrice = close
    slPrice = math.max(high, high[1])
    risk = slPrice - entryPrice
    tpPrice = entryPrice - (risk * rrTarget)

    // Draw the new geometry
    entryLine := line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.blue, width=1, style=line.style_dashed)
    slLine := line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=2, style=line.style_solid)
    tpLine := line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=2, style=line.style_solid)

    tpLabel := label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
    slLabel := label.new(bar_index + lineLen, slPrice, text="SL", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)

// 8. ALERTS
if longTrigger
    alert("🎯 SNIPER VERDICT: BUY\nBIAS: Bullish\nSETUP: Killzone + EMA + FVG + Engulfing.\nEXECUTION: Entry on Close | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)

if shortTrigger
    alert("🎯 SNIPER VERDICT: SELL\nBIAS: Bearish\nSETUP: Killzone + EMA + FVG + Engulfing.\nEXECUTION: Entry on Close | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)