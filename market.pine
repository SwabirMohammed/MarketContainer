//@version=6
indicator("Sniper Edge Engine v16 [Theme-Adaptive Matrix]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// 1. INPUTS & RISK
rrTarget       = input.float(3.0, title="Risk-to-Reward Ratio (1:X)")
swingLen       = input.int(5, title="LTF Swing Length (For CHoCH)")
lineLen        = input.int(15, title="Projection Length (Bars)")
signalCooldown = input.int(15, title="Signal Cooldown (Bars)")
minFvgSize     = input.float(1.5, title="Minimum HTF FVG Size (Price Points)")
useEmaFilter   = input.bool(false, title="Use 200 EMA Trend Filter")

// Theme Customization Input
useLightModeLabels = input.bool(false, title="Use Light Mode Text Colors (Dark Gray)")

// Session Killzone Inputs
londonZone = input.session("0800-1130", title="London Killzone")
nyZone     = input.session("1330-1600", title="New York Killzone")

// 2. FILTERS & THEME-ADAPTIVE LABELING
inLondon = not na(time(timeframe.period, londonZone))
inNY     = not na(time(timeframe.period, nyZone))
inKillzone = inLondon or inNY

// Assign text color based on user theme choice
textColorStyle = useLightModeLabels ? color.new(#1a1a1a, 20) : color.new(color.white, 0)

// Shading backdrops
bgcolor(inLondon ? color.new(color.blue, 96) : na, title="London Zone Background")
bgcolor(inNY ? color.new(color.navy, 96) : na, title="New York Zone Background")

// Dynamic Text Overlays with Theme Adjustments
if inLondon and not inLondon[1]
    label.new(bar_index, high + 2, text="LONDON KILLZONE\n[Look for FVG Sweep & CHoCH Reversal]", color=color.new(color.white, 100), textcolor=textColorStyle, style=label.style_label_down, size=size.normal)

if inNY and not inNY[1]
    label.new(bar_index, high + 2, text="NEW YORK KILLZONE\n[Look for NY Open Volatility & FVG Tap]", color=color.new(color.white, 100), textcolor=textColorStyle, style=label.style_label_down, size=size.normal)

ema200 = ta.ema(close, 200)
plot(useEmaFilter ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// 3. LIVE & PREVIOUS SESSION LIQUIDITY (White Straight Lines)
tokyoHours  = "2000-0300"
londonHours = "0300-0800"
nyHours     = "0800-1700"

inTokyoTrk  = not na(time(timeframe.period, tokyoHours))
inLondonTrk = not na(time(timeframe.period, londonHours))
inNYTrk     = not na(time(timeframe.period, nyHours))

var float activeH = na, var float activeL = na
var float prevH = na, var float prevL = na
var string sessionName = "", var string prevSessionName = ""

var line activeHLine = na, var line activeLLine = na
var label activeHLabel = na, var label activeLLabel = na
var line prevHLine = na, var line prevLLine = na
var label prevHLabel = na, var label prevLLabel = na

isNewSession = (inTokyoTrk and not inTokyoTrk[1]) or (inLondonTrk and not inLondonTrk[1]) or (inNYTrk and not inNYTrk[1])

if isNewSession
    prevH := activeH
    prevL := activeL
    prevSessionName := sessionName

    if inTokyoTrk
        sessionName := "Tokyo"
    else if inLondonTrk
        sessionName := "London"
    else if inNYTrk
        sessionName := "New York"

    activeH := high
    activeL := low

    if not na(prevHLine)
        line.delete(prevHLine), line.delete(prevLLine)
        label.delete(prevHLabel), label.delete(prevLLabel)
    if not na(activeHLine)
        line.delete(activeHLine), line.delete(activeLLine)
        label.delete(activeHLabel), label.delete(activeLLabel)

    if not na(prevH)
        prevHLine := line.new(bar_index, prevH, bar_index + 10, prevH, color=color.white, width=1, style=line.style_dotted)
        prevLLine := line.new(bar_index, prevL, bar_index + 10, prevL, color=color.white, width=1, style=line.style_dotted)
        prevHLabel := label.new(bar_index + 10, prevH, prevSessionName + " High", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
        prevLLabel := label.new(bar_index + 10, prevL, prevSessionName + " Low", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)

    activeHLine := line.new(bar_index, activeH, bar_index + 10, activeH, color=color.white, width=2, style=line.style_solid)
    activeLLine := line.new(bar_index, activeL, bar_index + 10, activeL, color=color.white, width=2, style=line.style_solid)
    activeHLabel := label.new(bar_index + 10, activeH, sessionName + " High", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
    activeLLabel := label.new(bar_index + 10, activeL, sessionName + " Low", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)

else if inTokyoTrk or inLondonTrk or inNYTrk
    activeH := math.max(activeH, high)
    activeL := math.min(activeL, low)
    line.set_y1(activeHLine, activeH), line.set_y2(activeHLine, activeH), line.set_x2(activeHLine, bar_index + 10)
    line.set_y1(activeLLine, activeL), line.set_y2(activeLLine, activeL), line.set_x2(activeLLine, bar_index + 10)
    label.set_xy(activeHLabel, bar_index + 10, activeH), label.set_xy(activeLLabel, bar_index + 10, activeL)

    if not na(prevHLine)
        line.set_x2(prevHLine, bar_index + 10), line.set_x2(prevLLine, bar_index + 10)
        label.set_x(prevHLabel, bar_index + 10), label.set_x(prevLLabel, bar_index + 10)
else
    if not na(activeHLine)
        line.set_x2(activeHLine, bar_index + 10), line.set_x2(activeLLine, bar_index + 10)
        label.set_x(activeHLabel, bar_index + 10), label.set_x(activeLLabel, bar_index + 10)
    if not na(prevHLine)
        line.set_x2(prevHLine, bar_index + 10), line.set_x2(prevLLine, bar_index + 10)
        label.set_x(prevHLabel, bar_index + 10), label.set_x(prevLLabel, bar_index + 10)


// 4. SIZE-FILTERED & ANCHORED HTF FVG MATRIX
f_get_fvg() =>
    bullGap = low[0] - high[2]
    bearGap = low[2] - high[0]
    bull = bullGap >= minFvgSize and close[1] > high[2]
    bear = bearGap >= minFvgSize and close[1] < low[2]
    [bull, bear, low[0], high[2], low[2], high[0]]

[b15, s15, bTop15, bBot15, sTop15, sBot15] = request.security(syminfo.tickerid, "15", f_get_fvg(), barmerge.gaps_off, barmerge.lookahead_off)
[b60, s60, bTop60, bBot60, sTop60, sBot60] = request.security(syminfo.tickerid, "60", f_get_fvg(), barmerge.gaps_off, barmerge.lookahead_off)
[b240, s240, bTop240, bBot240, sTop240, sBot240] = request.security(syminfo.tickerid, "240", f_get_fvg(), barmerge.gaps_off, barmerge.lookahead_off)

offset15  = math.max(1, math.round(timeframe.in_seconds("15")  / timeframe.in_seconds(timeframe.period))) * 2
offset60  = math.max(1, math.round(timeframe.in_seconds("60")  / timeframe.in_seconds(timeframe.period))) * 2
offset240 = math.max(1, math.round(timeframe.in_seconds("240") / timeframe.in_seconds(timeframe.period))) * 2

var float actBull15Top = na, var float actBull15Bot = na
var float actBear15Top = na, var float actBear15Bot = na
var float actBull60Top = na, var float actBull60Bot = na
var float actBear60Top = na, var float actBear60Bot = na
var float actBull240Top = na, var float actBull240Bot = na
var float actBear240Top = na, var float actBear240Bot = na

if b15 and not b15[1]
    actBull15Top := bTop15, actBull15Bot := bBot15
    box.new(bar_index - offset15, actBull15Top, bar_index + 50, actBull15Bot, border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 90), text="15M FVG", text_color=color.green, text_size=size.small, text_halign=text.align_center)
if s15 and not s15[1]
    actBear15Top := sTop15, actBear15Bot := sBot15
    box.new(bar_index - offset15, actBear15Top, bar_index + 50, actBear15Bot, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 90), text="15M FVG", text_color=color.red, text_size=size.small, text_halign=text.align_center)

if b60 and not b60[1]
    actBull60Top := bTop60, actBull60Bot := bBot60
    box.new(bar_index - offset60, actBull60Top, bar_index + 50, actBull60Bot, border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 85), text="1H FVG", text_color=color.green, text_size=size.small, text_halign=text.align_center)
if s60 and not s60[1]
    actBear60Top := sTop60, actBear60Bot := sBot60
    box.new(bar_index - offset60, actBear60Top, bar_index + 50, actBear60Bot, border_color=color.new(color.red, 30), bgcolor=color.new(color.red, 85), text="1H FVG", text_color=color.red, text_size=size.small, text_halign=text.align_center)

if b240 and not b240[1]
    actBull240Top := bTop240, actBull240Bot := bBot240
    box.new(bar_index - offset240, actBull240Top, bar_index + 50, actBull240Bot, border_color=color.new(color.green, 10), bgcolor=color.new(color.green, 80), text="4H FVG", text_color=color.green, text_size=size.normal, text_halign=text.align_center)
if s240 and not s240[1]
    actBear240Top := sTop240, actBear240Bot := sBot240
    box.new(bar_index - offset240, actBear240Top, bar_index + 50, actBear240Bot, border_color=color.new(color.red, 10), bgcolor=color.new(color.red, 80), text="4H FVG", text_color=color.red, text_size=size.normal, text_halign=text.align_center)

// 5. LTF MARKET STRUCTURE (CHoCH) 
sh = ta.pivothigh(high, swingLen, swingLen)
sl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na, var float lastSL = na
if not na(sh)
    lastSH := sh
if not na(sl)
    lastSL := sl

bullCHoCH = ta.crossover(close, lastSH)
bearCHoCH = ta.crossunder(close, lastSL)

var int bias = 0 
if bullCHoCH
    bias := 1 
if bearCHoCH
    bias := -1 

// 6. LTF ENGULFING DISPLACEMENT
bullEngulf = close > high[1] and close > open
bearEngulf = close < low[1] and close < open

// 7. MULTI-TIMEFRAME EXECUTION TRIGGERS & COOLDOWN
trendBull = not useEmaFilter or (close > ema200)
trendBear = not useEmaFilter or (close < ema200)

inBull15  = (low <= actBull15Top and high >= actBull15Bot)
inBull60  = (low <= actBull60Top and high >= actBull60Bot)
inBull240 = (low <= actBull240Top and high >= actBull240Bot)
inAnyBullHTF = inBull15 or inBull60 or inBull240

inBear15  = (high >= actBear15Bot and low <= actBear15Top)
inBear60  = (high >= actBear60Bot and low <= actBear60Top)
inBear240 = (high >= actBear240Bot and low <= actBear240Top)
inAnyBearHTF = inBear15 or inBear60 or inBear240

var int lastTradeBar = 0
cooldownPassed = (bar_index - lastTradeBar) >= signalCooldown

longTrigger  = inKillzone and trendBull and (bias == 1) and bullEngulf and inAnyBullHTF and cooldownPassed
shortTrigger = inKillzone and trendBear and (bias == -1) and bearEngulf and inAnyBearHTF and cooldownPassed

// 8. DRAWING THICK TRADE LINES & LABELS (High Visibility White Entry)
if longTrigger
    lastTradeBar := bar_index 
    entryPrice = close
    slPrice = math.min(low, low[1]) 
    risk = entryPrice - slPrice
    tpPrice = entryPrice + (risk * rrTarget)

    line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.white, width=2, style=line.style_dashed)
    line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=3, style=line.style_solid)
    line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=3, style=line.style_solid)

    label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, entryPrice, text="Entry", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, slPrice, text="SL", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

if shortTrigger
    lastTradeBar := bar_index 
    entryPrice = close
    slPrice = math.max(high, high[1])
    risk = slPrice - entryPrice
    tpPrice = entryPrice - (risk * rrTarget)

    line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.white, width=2, style=line.style_dashed)
    line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=3, style=line.style_solid)
    line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=3, style=line.style_solid)

    label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, entryPrice, text="Entry", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, slPrice, text="SL", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left, size=size.small)