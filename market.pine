//@version=6
indicator("Sniper Edge Engine v9 [Dual Session Liquidity]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// 1. INPUTS & RISK
rrTarget = input.float(3.0, title="Risk-to-Reward Ratio (1:X)")
swingLen = input.int(5, title="Swing Length (For CHoCH)")
lineLen  = input.int(15, title="Projection Length (Bars)")
useEmaFilter = input.bool(true, title="Use 200 EMA Trend Filter")
killZone = input.session("0800-1130,1330-1600", title="Execution Killzones")

// 2. FILTERS (THE FIREWALL)
inKillzone = not na(time(timeframe.period, killZone))
bgcolor(inKillzone ? color.new(color.blue, 95) : na, title="Killzone Background")

ema200 = ta.ema(close, 200)
plot(useEmaFilter ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// 3. LIVE & PREVIOUS SESSION LIQUIDITY (White Straight Lines)
tokyoZone  = input.session("2000-0300", title="Tokyo Session")
londonZone = input.session("0300-0800", title="London Session")
nyZone     = input.session("0800-1700", title="New York Session")

inTokyo  = not na(time(timeframe.period, tokyoZone))
inLondon = not na(time(timeframe.period, londonZone))
inNY     = not na(time(timeframe.period, nyZone))

var float activeH = na
var float activeL = na
var float prevH = na
var float prevL = na
var string sessionName = ""
var string prevSessionName = ""

var line activeHLine = na
var line activeLLine = na
var label activeHLabel = na
var label activeLLabel = na

var line prevHLine = na
var line prevLLine = na
var label prevHLabel = na
var label prevLLabel = na

isNewSession = (inTokyo and not inTokyo[1]) or (inLondon and not inLondon[1]) or (inNY and not inNY[1])

if isNewSession
    // Lock in the previous session
    prevH := activeH
    prevL := activeL
    prevSessionName := sessionName

    // Set the new active session
    if inTokyo
        sessionName := "Tokyo"
    else if inLondon
        sessionName := "London"
    else if inNY
        sessionName := "New York"

    activeH := high
    activeL := low

    // Erase old lines to prevent infinite clutter
    if not na(prevHLine)
        line.delete(prevHLine)
        line.delete(prevLLine)
        label.delete(prevHLabel)
        label.delete(prevLLabel)
    if not na(activeHLine)
        line.delete(activeHLine)
        line.delete(activeLLine)
        label.delete(activeHLabel)
        label.delete(activeLLabel)

    // Draw PREVIOUS session lines (Dotted White)
    if not na(prevH)
        prevHLine := line.new(bar_index, prevH, bar_index + 10, prevH, color=color.white, width=1, style=line.style_dotted)
        prevLLine := line.new(bar_index, prevL, bar_index + 10, prevL, color=color.white, width=1, style=line.style_dotted)
        prevHLabel := label.new(bar_index + 10, prevH, prevSessionName + " High", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
        prevLLabel := label.new(bar_index + 10, prevL, prevSessionName + " Low", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)

    // Draw ACTIVE session lines (Solid White)
    activeHLine := line.new(bar_index, activeH, bar_index + 10, activeH, color=color.white, width=2, style=line.style_solid)
    activeLLine := line.new(bar_index, activeL, bar_index + 10, activeL, color=color.white, width=2, style=line.style_solid)
    activeHLabel := label.new(bar_index + 10, activeH, sessionName + " High", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)
    activeLLabel := label.new(bar_index + 10, activeL, sessionName + " Low", color=color.new(color.white, 100), textcolor=color.white, style=label.style_label_left, size=size.small)

else if inTokyo or inLondon or inNY
    // Expand active session highs/lows live
    activeH := math.max(activeH, high)
    activeL := math.min(activeL, low)

    // Push active lines forward
    line.set_y1(activeHLine, activeH)
    line.set_y2(activeHLine, activeH)
    line.set_x2(activeHLine, bar_index + 10)
    line.set_y1(activeLLine, activeL)
    line.set_y2(activeLLine, activeL)
    line.set_x2(activeLLine, bar_index + 10)
    label.set_xy(activeHLabel, bar_index + 10, activeH)
    label.set_xy(activeLLabel, bar_index + 10, activeL)

    // Push previous session lines forward
    if not na(prevHLine)
        line.set_x2(prevHLine, bar_index + 10)
        line.set_x2(prevLLine, bar_index + 10)
        label.set_x(prevHLabel, bar_index + 10)
        label.set_x(prevLLabel, bar_index + 10)

else
    // If between sessions, just push everything forward horizontally
    if not na(activeHLine)
        line.set_x2(activeHLine, bar_index + 10)
        line.set_x2(activeLLine, bar_index + 10)
        label.set_x(activeHLabel, bar_index + 10)
        label.set_x(activeLLabel, bar_index + 10)
    if not na(prevHLine)
        line.set_x2(prevHLine, bar_index + 10)
        line.set_x2(prevLLine, bar_index + 10)
        label.set_x(prevHLabel, bar_index + 10)
        label.set_x(prevLLabel, bar_index + 10)


// 4. MARKET STRUCTURE (CHoCH) & ORDER BLOCKS
sh = ta.pivothigh(high, swingLen, swingLen)
sl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
if not na(sh)
    lastSH := sh
if not na(sl)
    lastSL := sl

bullCHoCH = ta.crossover(close, lastSH)
bearCHoCH = ta.crossunder(close, lastSL)

var int bias = 0 
if bullCHoCH
    bias := 1 
    box.new(bar_index[2], high[2], bar_index, low[2], border_color=color.blue, bgcolor=color.new(color.blue, 85))
if bearCHoCH
    bias := -1 
    box.new(bar_index[2], high[2], bar_index, low[2], border_color=color.red, bgcolor=color.new(color.red, 85))

// 5. FAIR VALUE GAPS (FVG Boxes)
bullFVG = low[0] > high[2] and close[1] > high[2]
bearFVG = high[0] < low[2] and close[1] < low[2]

var float activeBullFVG = na
var float activeBearFVG = na

if bullFVG
    activeBullFVG := low[0]
    box.new(bar_index[2], high[2], bar_index, low[0], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 90))

if bearFVG
    activeBearFVG := high[0]
    box.new(bar_index[2], low[2], bar_index, high[0], border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 90))

// 6. ENGULFING DISPLACEMENT
bullEngulf = close > high[1] and close > open
bearEngulf = close < low[1] and close < open

// 7. EXECUTION TRIGGERS
trendBull = not useEmaFilter or (close > ema200)
trendBear = not useEmaFilter or (close < ema200)

longTrigger  = inKillzone and trendBull and (bias == 1) and bullEngulf and (bullFVG or (low <= activeBullFVG))
shortTrigger = inKillzone and trendBear and (bias == -1) and bearEngulf and (bearFVG or (high >= activeBearFVG))

// 8. DRAWING THICK TRADE LINES
if longTrigger
    entryPrice = close
    slPrice = math.min(low, low[1]) 
    risk = entryPrice - slPrice
    tpPrice = entryPrice + (risk * rrTarget)

    line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.blue, width=2, style=line.style_dashed)
    line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=3, style=line.style_solid)
    line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=3, style=line.style_solid)

    label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, slPrice, text="SL", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

if shortTrigger
    entryPrice = close
    slPrice = math.max(high, high[1])
    risk = slPrice - entryPrice
    tpPrice = entryPrice - (risk * rrTarget)

    line.new(bar_index, entryPrice, bar_index + lineLen, entryPrice, color=color.blue, width=2, style=line.style_dashed)
    line.new(bar_index, slPrice, bar_index + lineLen, slPrice, color=color.red, width=3, style=line.style_solid)
    line.new(bar_index, tpPrice, bar_index + lineLen, tpPrice, color=color.green, width=3, style=line.style_solid)

    label.new(bar_index + lineLen, tpPrice, text="TP (" + str.tostring(rrTarget) + "R)", color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_left, size=size.small)
    label.new(bar_index + lineLen, slPrice, text="SL", color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

// 9. ALERTS
if longTrigger
    alert("🎯 SNIPER VERDICT: BUY\nBIAS: Bullish\nSETUP: Killzone + EMA + FVG + OB + Engulfing.\nEXECUTION: Entry on Close | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)

if shortTrigger
    alert("🎯 SNIPER VERDICT: SELL\nBIAS: Bearish\nSETUP: Killzone + EMA + FVG + OB + Engulfing.\nEXECUTION: Entry on Close | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)