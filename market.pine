//@version=6
indicator("Sniper Edge Engine v2 [CHoCH + Engulfing + FVG]", overlay=true, max_boxes_count=500, max_labels_count=500)

// 1. INPUTS & RISK
rrTarget = input.float(3.0, title="Risk-to-Reward Ratio (1:X)")
swingLen = input.int(5, title="Swing Length (For CHoCH)")

// 2. PREVIOUS SESSION LIQUIDITY (PDH / PDL)
pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
plot(pdh, "PDH Liquidity", color=color.new(color.red, 50), style=plot.style_stepline, linewidth=2)
plot(pdl, "PDL Liquidity", color=color.new(color.green, 50), style=plot.style_stepline, linewidth=2)

// 3. MARKET STRUCTURE (CHoCH)
// Identify swing points to determine shifts in market bias
sh = ta.pivothigh(high, swingLen, swingLen)
sl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
if not na(sh)
    lastSH := sh
if not na(sl)
    lastSL := sl

// Change of Character occurs when body closes past the last swing
bullCHoCH = ta.crossover(close, lastSH)
bearCHoCH = ta.crossunder(close, lastSL)

// System Bias Memory
var int bias = 0 
if bullCHoCH
    bias := 1 // Bullish Bias
if bearCHoCH
    bias := -1 // Bearish Bias

// 4. FAIR VALUE GAPS (FVG)
// Three-candle imbalance pattern
bullFVG = low[0] > high[2] and close[1] > high[2]
bearFVG = high[0] < low[2] and close[1] < low[2]

// Track the most recent FVG boundaries to ensure price is interacting with it
var float activeBullFVG = na
var float activeBearFVG = na
if bullFVG
    activeBullFVG := low[0]
if bearFVG
    activeBearFVG := high[0]

// 5. THE FIREWALL: ENGULFING DISPLACEMENT
// Bullish Engulf: Body closes above the previous candle's high
bullEngulf = close > high[1] and close > open
// Bearish Engulf: Body closes beneath the previous candle's low
bearEngulf = close < low[1] and close < open

// 6. EXECUTION TRIGGERS
// Must have: Correct Bias + Engulfing Confirmation + FVG Presence
longTrigger  = (bias == 1) and bullEngulf and (bullFVG or (low <= activeBullFVG))
shortTrigger = (bias == -1) and bearEngulf and (bearFVG or (high >= activeBearFVG))

// Print signals on the chart
plotshape(longTrigger, title="Buy Execution", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.small)
plotshape(shortTrigger, title="Sell Execution", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.small)

// 7. ALERTS
if longTrigger
    alert("🎯 SNIPER VERDICT: BUY\nBIAS: Bullish\nSETUP: Bull CHoCH + FVG Tap + Engulfing Rejection.\nEXECUTION: Entry on Close | SL: Below Trigger Wick | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)

if shortTrigger
    alert("🎯 SNIPER VERDICT: SELL\nBIAS: Bearish\nSETUP: Bear CHoCH + FVG Tap + Engulfing Rejection.\nEXECUTION: Entry on Close | SL: Above Trigger Wick | TP: 1:" + str.tostring(rrTarget) + " RR\nRISK: Max 5%", alert.freq_once_per_bar_close)